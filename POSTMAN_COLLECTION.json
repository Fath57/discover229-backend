{
  "info": {
    "name": "Discover229 - API Complete",
    "description": "Collection Postman complète pour tester tous les endpoints de l'API Sanctum avec HTTP-only cookies",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "discover229-api",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication - Session Initialization",
      "item": [
        {
          "name": "1. GET - Initialize CSRF Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Session initialized', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "console.log('✅ CSRF Session initialized - Cookies stored automatically');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sanctum/csrf-cookie",
              "host": ["{{base_url}}"],
              "path": ["sanctum", "csrf-cookie"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication - Login/Register",
      "item": [
        {
          "name": "2. POST - User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('user-id', jsonData.data.user.id);",
                  "    pm.collectionVariables.set('user-email', jsonData.data.user.email);",
                  "    pm.test('✅ Login successful', function() {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "        pm.expect(jsonData.data.user.email).to.exist;",
                  "    });",
                  "    console.log('✅ Logged in as:', jsonData.data.user.email);",
                  "} else {",
                  "    pm.test('❌ Login failed', function() {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@discover229.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3. POST - User Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test('✅ Registration successful', function() {",
                  "        pm.expect(pm.response.code).to.equal(201);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+22960000000\",\n  \"country_id\": 204,\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
